# Copy this file to .env (in hw6/) and fill in your own values.
# Placeholders only: the real .env is listed in .gitignore and is never committed.

# Required: Portkey key used for every AI call (all calls route through Portkey)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional (defaults shown). The course rule for HW6 is gpt-6-luna for every AI call.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-6-luna
